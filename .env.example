# Copy to .env:  cp .env.example .env
# Host ports are chosen to NOT clash with a local XAMPP (Apache :80/:443, MySQL :3306).
NGINX_PORT=8080
MYSQL_HOST_PORT=3307

# docker-compose builds DATABASE_URL from these (use URL-safe passwords: letters, digits, - _).
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=ottodot
MYSQL_USER=ottodot
MYSQL_PASSWORD=change-me

# Enables POST /api/dev/reset (re-seed) — demo only, keep false in real prod
ALLOW_DEV_RESET=true

# Running tests / demo from the host instead of docker:
#   cd main
#   DATABASE_URL=mysql://ottodot:change-me@127.0.0.1:3307/ottodot_test npm test
#   npm run demo:race
